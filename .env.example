# MyHOT 的配置。複製成 .env 再改（或者執行 node scripts/init-env.ts，它會生成 .env 並填好隨機金鑰）。
# 前端只拿到網站地址；所有金鑰只在後端。不要把 .env 提交到 Git。

# ===== 必填 =====

# 網站對外的地址：生成的連結、RSS、分享圖、MCP 都用它。本機試用就用下面這個。
SITE_URL=http://localhost:3000

# 管理員密碼（至少 12 位），登入 /admin 用。
ADMIN_PASSWORD=

# 會話簽名和圖片代理簽名的金鑰，各填一串隨機字元（可以用 openssl rand -hex 32 生成）。
SESSION_SECRET=
IMG_PROXY_SIGN_SECRET=

# 用 Docker 時資料庫的密碼（資料庫不對外開放埠，也請用隨機字元）。
POSTGRES_PASSWORD=

# 模型：任何 OpenAI 相容介面都可以，所有步驟預設都用它。下面是 DeepSeek 的寫法。
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-flash
# 服務商特有的請求引數（JSON），比如關掉思考模式：
LLM_EXTRA_JSON={"thinking":{"type":"disabled"}}
# RTX 的 automation profile 使用此金鑰，僅 worker 啟用 Luna；不要將金鑰提交至 Git。
# OPENAI_API_KEY=
# 其他服務商的例子：
#   千問      LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL=qwen3.8-flash  LLM_EXTRA_JSON={"enable_thinking":false}
#   智譜      LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4               LLM_MODEL=glm-5.3-flash  LLM_EXTRA_JSON={"thinking":{"type":"enabled"},"reasoning_effort":"low"}
# 模型能看圖就開啟（精選內容的標題摘要會參考首圖）：
# LLM_VISION=true
# 服務不支援 JSON 模式（response_format）時關掉：
# LLM_JSON_MODE=false
# 推理模型（先想再答，推理和答案共用輸出額度）額外給推理留的輸出額度，加在每一步自己的額度上，不填為 0。
# 呼叫報 “output token limit reached (finish_reason=length)” 時設它，比如：
# LLM_REASONING_TOKENS=4000

# ===== 選填：讓事件歸組更準 =====

# 向量召回：任何 OpenAI 相容的 /embeddings 介面。不填也能跑：歸組改用文字重合度找候選，
# 但只作熱度證據的討論帖（hot_signal 信源）大多掛不到事件上，熱度會偏低。
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small
# 或者只填阿里雲百鍊的 key，就用 text-embedding-v4：
# DASHSCOPE_API_KEY=
# 向量的維度（用 EMBEDDING_* 時預設取服務返回的，百鍊預設 1024）；改了以後舊向量會重新計算：
# EMBEDDING_DIMS=

# ===== 選填：每一步單獨換模型 =====
# 預設每一步都用上面的 LLM_*。想讓某一步用別家，填預設名（需要對應的 key）：
#   PREFILTER_MODEL  SCORE_MODEL  UNDERSTAND_MODEL  SUMMARIZE_MODEL  WORDING_MODEL  STRUCTURE_MODEL
#   GROUP_MODEL  GROUP_REVIEW_MODEL  DIGEST_MODEL  REPORT_MODEL  TRANSLATE_MODEL
# 預設名與需要的 key：
#   deepseek-flash / deepseek-flash-think        DEEPSEEK_BASE_URL=https://api.deepseek.com/v1  DEEPSEEK_API_KEY=
#   qwen3.7-flash / qwen3.8-flash / qwen3-vl-flash  DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  DASHSCOPE_API_KEY=
#   glm-5.3-flash / glm-5.3-flash-selection     ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4  ZHIPU_API_KEY=
#   mimo-v2.6-flash                             XIAOMI_MIMO_BASE_URL=https://api.xiaomimimo.com/v1  XIAOMI_MIMO_API_KEY=
# 注意：填了 DASHSCOPE_API_KEY、又沒填 EMBEDDING_API_KEY 時，歸組會自動用百鍊的向量（text-embedding-v4），按百鍊的價格另外計費。

# ===== 選填：付費的採集服務（按請求計費，有預算熔斷，在後臺“設定”裡調） =====
# X（推特）賬號：SocialData
# SOCIALDATA_API_KEY=
# 微信公眾號：極致了（Dajiala）
# DAJIALA_KEY=
# 抓不到正文時用瀏覽器渲染兜底：Jina Reader
# JINA_API_KEY=

# ===== 選填：飛書 =====
# 精選推送到飛書群（只推 T1、T1_5 信源的精選）：在後臺“設定 → 通知目的地”裡啟用，webhook 地址填在這裡。
FEISHU_CONTENT_PUSH_ENABLED=false
# FEISHU_PUSH_WEBHOOK_URL=
# FEISHU_PUSH_MIRROR_WEBHOOK_URL=
# 告警、回饋轉發到內部飛書群（回饋要一個飛書自建應用）：
FEISHU_INTERNAL_ENABLED=false
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_INTERNAL_CHAT_ID=
# FEISHU_ALERT_CHAT_ID=
# 告警只發文字，也可以發到一個群的自定義機器人：填了這個就走 webhook，不再用上面的應用和群 ID 發告警（不佔應用的介面呼叫量）。
# FEISHU_ALERT_WEBHOOK_URL=
# 告警先交給你自己的自動處理服務（比如能叫醒 AI 的 Webhook 中轉站），兩項都填、FEISHU_INTERNAL_ENABLED=true 時才用：
# 要處理的告警 POST 到這個地址（Authorization: Bearer <KEY>，JSON 欄位 id、type、subject、summary、detail、link），回 200 算收下，同一個 id 可能重發；
# 發給你本人的告警、恢復和系統日報先 POST 到同一主機根路徑的 /tell（JSON 欄位 key、text），沒收下再走上面的飛書。行為見 docs/deploy.md 的“更新”。
# WEBHOOK_HUB_URL=
# WEBHOOK_HUB_KEY=
# 用飛書賬號登入後臺（可選，和管理員密碼並存）：
# FEISHU_LOGIN_APP_ID=
# FEISHU_LOGIN_APP_SECRET=
# ADMIN_FEISHU_UNION_IDS=
# ADMIN_EMAILS=

# ===== 選填：其他 =====
# 讀 GitHub 介面（api.github.com）的 JSON 信源帶上它，配額更高。GitHub 免費申請，只要只讀許可權：
# GITHUB_TOKEN=
# 外部指令碼往站裡推送內容（POST /api/ingest/items）用的 token，至少 16 位；不填就關閉這個介面。
# INGEST_TOKEN=
# 推送介面每個客戶端每分鐘最多推幾次（docker compose 預設 10）；前面的反向代理已經限流時可以設成 0：
# INGEST_RATE_LIMIT=10
# 抓取海外信源要走代理時（比如伺服器在中國大陸）：
# EGRESS_PROXY_URL=http://127.0.0.1:7890
# 信源訂閱或列表地址用的是自建在內網的服務（比如同一 Docker 網路裡的 RSSHub）時，逗號分隔寫完整主機名（不區分大小寫，不支援通配）。
# 只放行這些地址本身，直連、不走上面的代理；跳到別的主機、文章正文、圖片仍不能連內網，鏈路本地和雲後設資料地址始終拒絕：
# PRIVATE_FEED_HOSTS=rsshub
# 圖片代理從原站取圖的流量上限（每分鐘多少 MB、每天多少 GB），超過後沒快取的圖先返回 503；不填就按 site/site.ts 的 DEPLOYMENT.imageUpstreamBudget，那裡預設不設上限：
# IMGPROXY_UPSTREAM_MB_PER_MINUTE=300
# IMGPROXY_UPSTREAM_GB_PER_DAY=30
# 前面有 Caddy 或 Nginx 這類反向代理時設為 true，訪客地址才從代理的 X-Forwarded-For 裡讀；
# 網站直接對外時保持 false，免得有人偽造地址繞過登入次數和回饋的限制。
# SITE_URL 為 HTTPS 且此項為 true 時，代理明示的 HTTP 請求會先轉到 HTTPS；
# 代理必須覆寫訪客自帶的 X-Forwarded-Proto。主機埠應限 loopback，避免繞過代理。
TRUST_PROXY=false
# MCP 只接受發給 SITE_URL 域名（和 localhost）的請求；還有別的訪問域名時，逗號分隔寫在這裡：
# MCP_ALLOWED_HOSTS=
# 網站多久沒有新內容就算“停止收錄”並告警（分鐘）；不填按 site/site.ts 的 ALERTS.quietMinutes（預設 360）：
# ALERT_QUIET_MINUTES=360
# 每天把新頁面提交給 IndexNow（Bing 等）；key 是 32 位十六進位制，自己生成一個：
INDEXNOW_SUBMIT_ENABLED=false
# INDEXNOW_KEY=
# 資料庫每天備份到 S3 相容的物件儲存（騰訊雲 COS、AWS S3、阿里雲 OSS……）。
# 不填 DB_BACKUP_STORE_DOMAIN 時按騰訊雲 COS 拼地址（<桶名>.cos.<地域>.myqcloud.com）；
# 用別家時填帶桶名的訪問域名，比如 AWS S3 填 my-bucket.s3.us-east-1.amazonaws.com：
# DB_BACKUP_STORE_SECRET_ID=
# DB_BACKUP_STORE_SECRET_KEY=
# DB_BACKUP_STORE_BUCKET=
# DB_BACKUP_STORE_REGION=
# DB_BACKUP_STORE_DOMAIN=
# 日誌級別（預設 info）和資料庫連線池上限（預設 10）：
# LOG_LEVEL=info
# DATABASE_POOL_MAX=10
# 版本名：顯示在後臺“執行”頁和 /api/health，升級後可以確認程序已經換新：
# AIHOT_RELEASE=
# 環境名，預設按 NODE_ENV 取 production 或 development；不是 production 時告警會帶上它，開發免登入也只在非 production 時可用：
# AIHOT_ENVIRONMENT=
# 把金鑰按組寫在一個目錄裡（models.env、collectors.env、integrations.env、auth.env），代替寫在這裡；這裡寫了的優先：
# AIHOT_CREDENTIALS_DIR=

# ===== 安全閥 =====
# 寫成 true 才抓信源（包括每天取信源圖示）、調模型；刪掉這兩行或改成 false 就都停下（除錯介面時有用）。
# 這份檔案裡所有 *_ENABLED 開關都只認 true，寫 1、yes 或 TRUE 都當作關。
COLLECT_ENABLED=true
MODEL_CALLS_ENABLED=true

# ===== 不用 Docker、直接在本機跑時才需要 =====
# DATABASE_URL=postgres://使用者名稱@127.0.0.1:5432/myhot
# API_BASE_URL=http://127.0.0.1:3001
# 上傳的檔案、圖片快取和本地備份放在哪個目錄（預設倉庫裡的 .data）：
# AIHOT_DATA_DIR=/var/lib/myhot
# 開發時免登入進後臺（生產環境會拒絕啟動），後臺顯示的名字：
# DEV_AUTH_ROLE=admin
# DEV_AUTH_DISPLAY_NAME=Dev Admin
# 本機除錯時允許抓內網地址（預設禁止，生產環境拒絕啟動）：
# ALLOW_PRIVATE_NETWORK_FETCH=true

# ===== 用 docker compose --profile https 時 =====
# SITE_DOMAIN=example.com
# 網站在本機開的埠（docker compose 用，預設 3000，所有網絡卡都能訪問）；用 HTTPS 時只給本機的 Caddy 用，不直接對外：
# PORT=127.0.0.1:3000
# 同時把上面的 TRUST_PROXY 改成 true。
